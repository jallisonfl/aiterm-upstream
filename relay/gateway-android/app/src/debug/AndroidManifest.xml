<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Debug-only host for instrumented Compose assertions. It can render
          over (but never dismiss) a secure keyguard and keeps the display awake
          only while a test owns the Activity.
        -->
        <activity
            android:name="com.adroited.aiterm.testing.ComposeTestActivity"
            android:exported="true"
            android:theme="@style/Theme.Aiterm" />
    </application>
</manifest>
